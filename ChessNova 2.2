
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ChessNova</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
<style>
*{box-sizing:border-box}
body{
 margin:0;background:#17151f;color:white;
 font-family:Arial,sans-serif;text-align:center;
 padding:20px 12px
}
h1{color:#b58aff;font-size:36px;margin:8px}
.subtitle{color:#aaa;margin-bottom:20px}
.panel{
 max-width:500px;margin:auto;background:#242130;
 padding:16px;border-radius:18px
}
select,button{
 border:0;border-radius:10px;padding:12px;
 font-size:16px;margin:5px
}
select{background:#393348;color:white}
button{
 background:#9257e8;color:white;font-weight:bold;
 cursor:pointer
}
button:active{transform:scale(.97)}
#board{
 width:min(94vw,440px);height:min(94vw,440px);
 margin:18px auto;display:grid;
 grid-template-columns:repeat(8,1fr);
 border:5px solid #40364f;border-radius:5px;
 overflow:hidden
}
.square{
 display:flex;align-items:center;justify-content:center;
 font-size:clamp(25px,8vw,48px);
 cursor:pointer;position:relative;aspect-ratio:1
}
.light{background:#e8d9c5}
.dark{background:#896c9c}
.selected{background:#b8a0ee!important}
.target:after{
 content:"";width:23%;height:23%;border-radius:50%;
 background:#50347c;position:absolute;opacity:.65
}
.white-piece{color:#fff;text-shadow:1px 2px 3px #333}
.black-piece{color:#28232e;text-shadow:1px 1px 2px #aaa}
#status{min-height:28px;color:#d5baff;font-weight:bold}
.small{font-size:13px;color:#aaa}
</style>
</head>
<body>
<h1>♟ ChessNova</h1>
<div class="subtitle">Your Chess Universe</div>

<div class="panel">
 <div>
  <label for="bot">Choose your opponent:</label><br>
  <select id="bot">
   <option value="oliver">Oliver — Beginner</option>
   <option value="merlin">Merlin — Strategist</option>
   <option value="blaze">Blaze — Attacker</option>
  </select>
 </div>

 <div id="board"></div>
 <div id="status">Your turn! You play White.</div>

 <button onclick="newGame()">New Game</button>
 <button onclick="undoMove()">Undo</button>
 <p class="small">Tap a piece, then tap its destination.</p>
</div>

<script>
const game = new Chess();
const board = document.getElementById("board");
const statusText = document.getElementById("status");

let selected = null;
let possible = [];

const symbols = {
 w:{k:"♔",q:"♕",r:"♖",b:"♗",n:"♘",p:"♙"},
 b:{k:"♚",q:"♛",r:"♜",b:"♝",n:"♞",p:"♟"}
};

function drawBoard(){
 board.innerHTML="";
 const position=game.board();

 for(let r=0;r<8;r++){
  for(let c=0;c<8;c++){
   const square=document.createElement("div");
   const file="abcdefgh"[c];
   const rank=8-r;
   const name=file+rank;
   const piece=position[r][c];

   square.className="square "+((r+c)%2?"dark":"light");

   if(selected===name)square.classList.add("selected");
   if(possible.some(m=>m.to===name))square.classList.add("target");

   if(piece){
    square.textContent=symbols[piece.color][piece.type];
    square.classList.add(piece.color==="w"?"white-piece":"black-piece");
   }

   square.onclick=()=>tapSquare(name);
   board.appendChild(square);
  }
 }
}

function updateStatus(){
 if(game.in_checkmate()){
  statusText.textContent=game.turn()==="w"?
   "Checkmate! The bot wins!":"Checkmate! You win! 🎉";
 }else if(game.in_draw()){
  statusText.textContent="Draw!";
 }else if(game.in_check()){
  statusText.textContent="Check!";
 }else{
  statusText.textContent=game.turn()==="w"?
   "Your turn!":"Bot is thinking...";
 }
}

function tapSquare(name){
 if(game.game_over()||game.turn()!=="w")return;

 const piece=game.get(name);

 if(selected){
  const move=game.move({
   from:selected,to:name,promotion:"q"
  });

  if(move){
   selected=null;
   possible=[];
   drawBoard();
   updateStatus();

   if(!game.game_over()){
    setTimeout(botMove,350);
   }
   return;
  }
 }

 if(piece&&piece.color==="w"){
  selected=name;
  possible=game.moves({square:name,verbose:true});
 }else{
  selected=null;
  possible=[];
 }
 drawBoard();
}

function evaluate(){
 const values={p:100,n:320,b:330,r:500,q:900,k:0};
 let score=0;
 const position=game.board();

 for(const row of position){
  for(const piece of row){
   if(piece){
    score+=(piece.color==="b"?1:-1)*values[piece.type];
   }
  }
 }
 return score;
}

function botMove(){
 if(game.game_over()||game.turn()!=="b")return;

 const moves=game.moves({verbose:true});
 if(!moves.length)return;

 const style=document.getElementById("bot").value;
 let chosen;

 if(style==="oliver"){
  chosen=moves[Math.floor(Math.random()*moves.length)];
 }

 if(style==="merlin"){
  let best=-Infinity;
  for(const move of moves){
   game.move(move);
   const score=evaluate();
   game.undo();
   if(score>best){
    best=score;
    chosen=move;
   }
  }
 }

 if(style==="blaze"){
  let best=-Infinity;
  for(const move of moves){
   game.move(move);
   let score=evaluate();
   if(game.in_check())score+=35;
   if(move.captured)score+=80;
   game.undo();
   if(score>best){
    best=score;
    chosen=move;
   }
  }
 }

 game.move({
  from:chosen.from,
  to:chosen.to,
  promotion:"q"
 });

 drawBoard();
 updateStatus();
}

function newGame(){
 game.reset();
 selected=null;
 possible=[];
 drawBoard();
 updateStatus();
}

function undoMove(){
 if(game.history().length===0)return;
 game.undo();
 if(game.turn()==="b"&&game.history().length>0)game.undo();
 selected=null;
 possible=[];
 drawBoard();
 updateStatus();
}

drawBoard();
updateStatus();
</script>
</body>
</html>
